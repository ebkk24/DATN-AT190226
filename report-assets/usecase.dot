digraph G { graph [rankdir=LR,bgcolor="white",pad=0.25,nodesep=0.35,ranksep=0.65,fontname="DejaVu Serif",label=""]; node [shape=ellipse,style="filled",fillcolor="white",color="black",fontname="DejaVu Serif",fontsize=11]; edge [color="black",fontname="DejaVu Serif",fontsize=9]; maker [shape=box,label="Maker\n(Cán bộ lập)"]; checker [shape=box,label="Checker\n(Cán bộ duyệt)"]; student [shape=box,label="Student\n(Người học)"]; public [shape=box,label="Bên xác minh\ncông khai"]; admin [shape=box,label="Admin\n(Quản trị)"]; subgraph cluster_sys {label="Hệ thống quản lý VBCC";color=black; issue [label="Tạo yêu cầu\nphát hành"]; approve [label="Duyệt / từ chối\nyêu cầu"]; revoke [label="Thu hồi\nchứng thư"]; manage [label="Quản lý người dùng\nvà cấu hình đơn vị"]; view [label="Xem / tải\nchứng thư cá nhân"]; verify [label="Xác minh\nchứng thư"]; audit [label="Tra cứu nhật ký\nkiểm toán"]; } maker->issue; maker->audit; checker->approve; checker->revoke; checker->audit; student->view; public->verify; admin->manage; admin->audit; }