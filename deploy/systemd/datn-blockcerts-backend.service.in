[Unit]
Description=DATN Blockcerts Backend and Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DATN_ROOT@/backend
EnvironmentFile=@DATN_ROOT@/.env
Environment=NODE_ENV=production
UMask=0077
ExecStartPre="@NPM@" run migration:run
ExecStart="@NODE@" dist/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
