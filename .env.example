# Sao chép thành .env và thay CHANGE_ME bằng giá trị bí mật ngẫu nhiên.
# Không commit tệp .env.

# PostgreSQL
POSTGRES_DB=datn_blockcerts
POSTGRES_USER=datn_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis / BullMQ
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Bitcoin Core regtest
BITCOIN_RPC_USER=datn_rpc
BITCOIN_RPC_PASSWORD=CHANGE_ME
BITCOIN_RPC_URL=http://127.0.0.1:18443
ISSUING_ADDRESS=CHANGE_ME_PUBLIC_ADDRESS

# Backend
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
HOST=127.0.0.1
PORT=4000
DATN_ROOT=/absolute/path/to/datn-blockcerts
PUBLIC_BASE_URL=https://your-stable-host.example
CORS_ORIGINS=https://your-stable-host.example,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

LOCAL_UID=1000
LOCAL_GID=1000
